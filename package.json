{
  "name": "daily-task-manager",
  "version": "1.6.0",
  "description": "برنامهٔ مدیریت کارهای روزانه برای ویندوز",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:windows": "electron-builder --win --publish never",
    "publish:windows": "electron-builder --win --publish always",
    "build:web": "node scripts/copy-web-assets.js",
    "build:android": "npm run build:web && npx cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "ir.codex.dailytaskmanager",
    "productName": "مدیریت کارهای روزانه",
    "artifactName": "daily-task-manager-setup-${version}.${ext}",
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "eynolghalam",
        "repo": "daily-task-manager",
        "releaseType": "release"
      }
    ]
  }
}
